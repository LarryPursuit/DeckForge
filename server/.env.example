# Copy to .env and adjust.
# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
DATABASE_URL=sqlite:///deckforge.db
CORS_ORIGINS=http://localhost:5173

# Identify your app to Scryfall (required by their API rules)
SCRYFALL_USER_AGENT=Deckforge/0.1 (your-email@example.com)

# live = real Scryfall API, fake = offline demo with a few built-in cards
SCRYFALL_MODE=live
